@using ChromaDrop.Core.Game0
@implements IAsyncDisposable

<main class="game0">
  <svg class="game0-surface" style="@($"--game0-control-font: {N(24 / _scale)}px")" viewBox="0 0 1448 1086" preserveAspectRatio="xMidYMid meet" role="application" aria-label="Game0" aria-busy="@(!_ready)" tabindex="0" @ref="_surface">
    <defs>
      @for (var i = 0; i < ShapeColors.Length; i++)
      {
        <filter id="@($"game0-color-{i}")" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="@Game0Svg.TintMatrix(ShapeColors[i])" />
        </filter>
      }
      <filter id="game0-cream" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="@Game0Svg.TintMatrix("f6f1e4")" /></filter>
      <filter id="game0-pattern-tint" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="@Game0Svg.TintMatrix("1f406e")" /></filter>
      <pattern id="game0-pattern" width="48" height="48" patternUnits="userSpaceOnUse">
        <image href="assets/PixelUI/Pattern/quiet.png" width="48" height="48" opacity="0.04" filter="url(#game0-pattern-tint)" />
      </pattern>
    </defs>
    <rect width="1448" height="1086" fill="#246ab3" />
    <rect width="1448" height="1086" fill="url(#game0-pattern)" />
    <Game0FrameView X="158" Y="137" Width="1132" Height="180" />
    @for (var i = 0; i < Game0Session.HandSize; i++)
    {
      @if (_browser.Session.Hand[i] is { } shape)
      {
        var slot = Game0BrowserSession.HandSlot(i);
        @if (_browser.Session.Locked && _browser.Session.CanSelect(PieceSource.Hand, i))
        {
          <rect x="@N(slot.X - 2)" y="@N(slot.Y - 2)" width="@N(slot.Width + 4)" height="@N(slot.Height + 4)" fill="none" stroke="#f6f1e4" stroke-width="3" />
        }
        @foreach (var tile in MiniTiles(shape, false, slot))
        {
          <Game0TileView X="tile.X" Y="tile.Y" Size="tile.Size" Shape="shape" Alpha="@(InMotion(PieceSource.Hand, i) ? 0.4 : 1)" />
        }
      }
    }
    <rect x="383" y="360" width="636" height="636" fill="#112e50" />
    @for (var y = 0; y < Game0Session.Size; y++)
    {
      @for (var x = 0; x < Game0Session.Size; x++)
      {
        <rect x="@N(383 + x * Game0BrowserSession.CellSize)" y="@N(360 + y * Game0BrowserSession.CellSize)" width="@N(Game0BrowserSession.CellSize)" height="@N(Game0BrowserSession.CellSize)" fill="@((x + y) % 2 == 1 ? "#193b62" : "none")" stroke="#4a719a" stroke-opacity="0.45" stroke-width="1" />
      }
    }
    @foreach (var (cell, tile) in _browser.Session.Tiles)
    {
      <Game0TileView X="@(383 + cell.X * Game0BrowserSession.CellSize)" Y="@(360 + cell.Y * Game0BrowserSession.CellSize)" Size="Game0BrowserSession.CellSize" Shape="tile.Shape" Cat="tile.Cat" />
    }
    <Game0TileView X="@(383 + Game0Session.Center * Game0BrowserSession.CellSize)" Y="@(360 + Game0Session.Center * Game0BrowserSession.CellSize)" Size="Game0BrowserSession.CellSize" Center="true" />
    @if (_browser.Falling is { } fall)
    {
      @if (fall.Blocked && fall.Side == EntrySide.Top)
      {
        <rect x="@N(383 + fall.Lane * Game0BrowserSession.CellSize)" y="355" width="@N((fall.Cells.Max(cell => cell.X) + 1) * Game0BrowserSession.CellSize)" height="5" fill="#f16670" />
      }
      @foreach (var cell in fall.Cells)
      {
        var x = 383 + (fall.Origin.X + cell.X) * Game0BrowserSession.CellSize;
        var y = 360 + (fall.Origin.Y + cell.Y) * Game0BrowserSession.CellSize;
        @if (x + Game0BrowserSession.CellSize > 383 && x < 1019 && y + Game0BrowserSession.CellSize > 360 && y < 996)
        {
          <Game0TileView X="x" Y="y" Size="Game0BrowserSession.CellSize" Shape="fall.Shape" Cat="@(fall.Source == PieceSource.Cat)" />
        }
      }
    }
    @if (_browser.Dragging && _browser.SelectedShape is { } held)
    {
      var cells = Game0Session.ShapeCells(held, _browser.Orientation);
      @if (_browser.Source == PieceSource.Hand && _browser.CanDrop)
      {
        var width = (cells.Max(cell => cell.X) + 1) * Game0BrowserSession.CellSize;
        var left = 383 + _browser.Lane * Game0BrowserSession.CellSize;
        <rect x="@N(left)" y="355" width="@N(width)" height="5" fill="#30d6ef" />
        <svg x="@N(left + (width - 30) / 2)" y="323" width="30" height="30" viewBox="414 453 16 16" preserveAspectRatio="none" aria-hidden="true"><image href="assets/PixelUI/sheet.png" width="538" height="592" /></svg>
      }
      @foreach (var cell in cells)
      {
        <Game0TileView X="@(_browser.Pointer.X + (cell.X - 1) * Game0BrowserSession.CellSize * 0.7)" Y="@(_browser.Pointer.Y + (cell.Y - 1) * Game0BrowserSession.CellSize * 0.7)" Size="@(Game0BrowserSession.CellSize * 0.7)" Shape="held" Cat="@(_browser.Source == PieceSource.Cat)" Alpha="0.8" />
      }
    }
    <Game0FrameView X="1050" Y="520" Width="272" Height="500" />
    <line x1="1079" y1="645" x2="1292" y2="645" stroke="#52769a" stroke-width="3" />
    <line x1="1079" y1="753" x2="1292" y2="753" stroke="#52769a" stroke-width="3" />
    <image href="@(_browser.Session.ClockwiseNext ? "assets/Icons/rotate-clockwise.png" : "assets/Icons/rotate-counterclockwise.png")" x="1082" y="550" width="84" height="84" aria-hidden="true" />
    <svg x="1144" y="656" width="84" height="84" viewBox="@(_browser.Session.ClockwiseNext ? "414 469 16 16" : "398 469 16 16")" preserveAspectRatio="none" aria-hidden="true"><image href="assets/PixelUI/sheet.png" width="538" height="592" /></svg>
    @for (var i = 0; i < Game0Session.RotationPeriod; i++)
    {
      <circle cx="@(1192 + i * 28)" cy="590" r="10" fill="@(i < _browser.Session.UntilRotation ? "#f7ce46" : "#274c75")" />
    }
    @for (var i = 0; i < Game0Session.CatCapacity; i++)
    {
      var slot = Game0BrowserSession.CatSlot(i);
      <rect x="@N(slot.X)" y="@N(slot.Y)" width="96" height="96" fill="#16395f" stroke="#7d9bbc" stroke-width="3" />
      @if (_browser.Session.Cats[i] is { } shape)
      {
        @foreach (var tile in MiniTiles(shape, true, slot))
        {
          <Game0TileView X="tile.X" Y="tile.Y" Size="tile.Size" Shape="shape" Cat="true" Alpha="@(InMotion(PieceSource.Cat, i) ? 0.4 : 1)" />
        }
      }
    }
    <rect x="383" y="1005" width="636" height="30" fill="@(_browser.Session.Locked ? "#f32735" : "#133553")" />
    @if (!_browser.Session.Locked)
    {
      <rect x="383" y="1005" width="@N(636 * _browser.Session.HandTimeLeft / Game0Session.HandSeconds)" height="30" fill="#23e344" />
    }
    <rect x="383" y="1005" width="636" height="30" fill="none" stroke="#07182a" stroke-width="5" />
    @if (_browser.Paused)
    {
      <rect x="383" y="360" width="636" height="636" fill="black" opacity="0.5" />
    }
    @if (_browser.Session.IsOver)
    {
      <rect x="383" y="360" width="636" height="636" fill="black" opacity="0.65" />
      <g><text class="game0-over" x="701" y="676" text-anchor="middle" fill="#f6f1e4">GAME OVER</text></g>
      <foreignObject x="610" y="712" width="180" height="58" data-game0-control="true">
        <button class="game0-restart" data-game0-control="true" @onclick="Restart">重新开始</button>
      </foreignObject>
    }
    <text class="game0-score" x="239" y="83" fill="#f6f1e4" aria-label="Score">@_browser.Session.Score</text>
    <foreignObject x="1327" y="38" width="88" height="85" data-game0-control="true">
      <button class="game0-pause" data-game0-control="true" aria-label="@(_browser.Paused ? "继续" : "暂停")" disabled="@(_browser.Session.IsOver || !_ready)" @onclick="TogglePause">@(_browser.Paused ? "▶" : "Ⅱ")</button>
    </foreignObject>
  </svg>
</main>
