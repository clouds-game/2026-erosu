@using ChromaDrop.Localization
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (ready)
{
  <main class="game">
    <section class="playfield" aria-label="@T("board")">
      <svg viewBox="0 0 400 720" role="img" aria-label="@T("board_description")">
        <defs><pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse"><circle cx="20" cy="20" r="1" fill="#303946" /></pattern></defs>
        <rect width="400" height="720" fill="#1b212c" />
        <rect width="400" height="720" fill="url(#grid)" />
        @{ var riseOffset = game.Phase == GamePhase.Rising ? (1 - game.TransitionProgress) * (game.Transition?.Rows ?? 0) * 40 : 0; }
        <g transform="@($"translate(0 {riseOffset:0.###})")">
          @foreach (var piece in game.Board.Pieces)
          {
            <PieceView @key="piece.Id" Piece="piece" TurnsRemaining="game.TurnsRemaining(piece)" AriaLabel="@PieceLabel(piece)" />
          }
        </g>
        @if (game.Phase == GamePhase.Expiring && game.Transition is { } transition)
        {
          <g>
            @foreach (var piece in transition.RemovedPieces)
            {
              <PieceView Piece="piece" Opacity="@(1 - game.TransitionProgress)" AriaLabel="@PieceLabel(piece)" />
            }
          </g>
        }
        @if (game.Phase == GamePhase.Falling)
        {
          @if (game.Ghost() is { } ghost) { <PieceView Piece="ghost" Ghost="true" /> }
          @if (game.Active is { } active) { <PieceView Piece="active" AriaLabel="@PieceLabel(active)" /> }
        }
        @if (game.Wave is { } wave)
        {
          <g opacity="@(1 - game.ClearProgress * 0.8)">
            @foreach (var piece in wave.Pieces) { <PieceView Piece="piece" /> }
          </g>
        }
      </svg>
      @if (game.Paused || game.IsFinished)
      {
        <div class="overlay">
          <strong>@T(game.Paused ? "paused" : game.ResultTitleKey)</strong>
          <button @onclick="Confirm">@T(game.Paused ? "resume" : game.ContinueKey)</button>
          <small>@(game.Paused ? T("resume_hint") : ResultSummary())</small>
        </div>
      }
      else if (notice_key.Length > 0) { <div class="notice" role="status">@T(notice_key, notice_arguments)</div> }
    </section>
    <aside>
      <div class="overview">
        <select class="mode" aria-label="@T("mode")" value="@selection.Token" @onchange="SelectMode" @onfocus="PauseForFocus">
          @foreach (var mode in ModeCatalog.Standalone)
          {
            <option value="@mode.Token">@T(mode.Presentation.NameKey)</option>
          }
          @foreach (var tutorial in new[] { false, true })
          {
            <optgroup label="@T(tutorial ? "learn" : "challenges")">
              @foreach (var level in PuzzleLevels.All.Where(level => level.IsTutorial == tutorial))
              {
                <option value="@GameSelection.Puzzle(level.Number).Token">@T("puzzle_label", PuzzleLevels.DisplayNumber(level), T(level.TitleKey))@(IsCompleted(level.Number) ? " *" : "")</option>
              }
            </optgroup>
          }
        </select>
        <span class="muted">@T("score")</span><strong id="score">@UiText.Number(game.Score)</strong>
        @if (game.Capabilities.PuzzleObjectives && game.Puzzle is { } puzzle)
        {
          <p class="puzzle-goal">@T(puzzle.GoalKey, puzzle.Target)</p>
          <dl><dt>@T("remaining")</dt><dd>@game.Remaining</dd><dt>@T("cleared")</dt><dd id="cleared">@game.Cleared</dd></dl>
          @if (game.Capabilities.ShowFullSequence && !puzzle.IsTutorial && game.Next.Count > 0)
          {
            <span class="muted">@T("sequence")</span>
            <div class="previews">
              @foreach (var piece in game.Next)
              {
                <svg viewBox="-20 -10 200 100" role="img" aria-label="@PieceLabel(piece)"><PieceView Piece="piece" /></svg>
              }
            </div>
          }
          @if (IsCompleted(puzzle.Number)) { <span class="muted">@T("completed")</span> }
        }
        else
        {
          <span class="muted">@T("best", UiText.Number(Record("score")))</span>
          @foreach (var metric in game.Metrics.Where(metric => metric.Definition.Display == MetricDisplay.Counter))
          {
            <span class="muted">@T(metric.Definition.RecordLabelKey ?? metric.Definition.LabelKey, Record(metric.Key))</span>
          }
          <span class="next-label muted">@T("next")</span>
          <div class="previews">
            @foreach (var piece in game.Next)
            {
              <svg viewBox="-20 -10 200 100" role="img" aria-label="@PieceLabel(piece)"><PieceView Piece="piece" /></svg>
            }
          </div>
          <dl>
            <dt>@T("level")</dt><dd>@game.Level</dd>
            @foreach (var metric in game.Metrics.Where(metric => metric.Definition.Display is MetricDisplay.Progress or MetricDisplay.Counter))
            {
              <dt>@T(metric.Definition.LabelKey)</dt><dd>@metric.Value</dd>
            }
            @if (!game.Metrics.Any(metric => metric.Definition.Display == MetricDisplay.Counter))
            { <dt>@T("cleared")</dt><dd id="cleared">@game.Cleared</dd> }
            <dt>@T("chain")</dt><dd>×@game.BestChain</dd>
          </dl>
        }
      </div>
      <div class="actions">
        <p class="keys">← → @T("move")<br />↑ @T("rotate") · ↓ @T("soft_drop")<br />Space @T("drop") · P @T("pause")</p>
        <button @onclick="TogglePause" disabled="@game.IsFinished">@T(game.Paused ? "resume" : "pause") [P]</button>
        <button @onclick="() => Start()">@T("restart") [R]</button>
        <button @onclick="ShowHintOrDemo" disabled="@(game.Presentation.Help.Action == HelpAction.PuzzleHint && game.IsFinished)">@T(game.Presentation.Help.LabelKey) [F2]</button>
        <button @onclick="ToggleSound">@T(sound_enabled ? "sound_on" : "sound_off") [M]</button>
        <label class="language"><span>@T("language")</span>
          <select value="@texts.Language" @onchange="ChangeLanguage" @onfocus="PauseForFocus">
            @for (var i = 0; i < UiText.Languages.Length; i++)
            {
              <option value="@UiText.Languages[i]">@UiText.LanguageNames[i]</option>
            }
          </select>
        </label>
        <a class="downloads" href="https://github.com/clouds-game/2026-erosu/releases/tag/nightly">@T("downloads")</a>
      </div>
    </aside>
    <nav class="touch" aria-label="@T("controls")">
      <button aria-label="@T("left")" @onclick="() => game.Move(-1, 0)">←</button>
      <button aria-label="@T("rotate")" @onclick="() => game.Rotate()">↻</button>
      <button aria-label="@T("right")" @onclick="() => game.Move(1, 0)">→</button>
      <button aria-label="@T("down")" @onclick="() => game.Move(0, 1)">↓</button>
      <button @onclick="game.HardDrop">@T("drop")</button>
    </nav>
  </main>
}

@code {
  private GameSession game = null!;
  private IJSObjectReference? interop;
  private DotNetObjectReference<App>? callback;
  private readonly CancellationTokenSource cancellation = new();
  private readonly HashSet<string> held = [];
  private Task? loop;
  private GameSelection selection = GameSelection.Puzzle(PuzzleLevels.DefaultLevel);
  private readonly HashSet<int> completed_levels = [];
  private readonly Dictionary<string, int> records = [];
  private bool ready;
  private bool sound_enabled;
  private readonly UiText texts = new();
  private string notice_key = "";
  private object[] notice_arguments = [];
  private string T(string key, params object[] arguments) => texts.Get(key, arguments);
  private double notice_time;
  private int held_direction;
  private double repeat_time;
  private bool repeating;

  protected override void OnInitialized() => Start();

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    interop = await JS.InvokeAsync<IJSObjectReference>("import", "./interop.js?v=modes-2");
    texts.SetLanguage(await interop.InvokeAsync<string>("loadLanguage"));
    await interop.InvokeVoidAsync("setLanguage", texts.Language);
    foreach (var mode in ModeCatalog.Standalone)
      foreach (var metric in mode.Metrics.Where(metric => metric.RecordPolicy == RecordPolicy.Max))
      {
        var key = ModeCatalog.RecordKey(mode.Id, metric.Key);
        var legacy = (mode.Id, metric.Key) switch
        {
          (ModeId.Free, "score") => "chroma_best",
          (ModeId.Pollution, "score") => "chroma_pollution_best",
          (ModeId.Pollution, "purified") => "chroma_pollution_cleared",
          _ => ""
        };
        records[key] = await interop.InvokeAsync<int>("loadRecord", key, legacy);
      }
    foreach (var number in await interop.InvokeAsync<int[]>("loadCompletedIds"))
      if (PuzzleLevels.All.Any(level => level.Number == number)) completed_levels.Add(number);
    callback = DotNetObjectReference.Create(this);
    await interop.InvokeVoidAsync("connect", callback);
    ready = true;
    StateHasChanged();
    loop = RunLoop();
  }

  private async Task ChangeLanguage(ChangeEventArgs args)
  {
    texts.SetLanguage(args.Value?.ToString());
    if (interop is not null) await interop.InvokeVoidAsync("setLanguage", texts.Language);
  }

  private async Task RunLoop()
  {
    using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(33));
    var clock = System.Diagnostics.Stopwatch.StartNew();
    var previous = clock.Elapsed.TotalSeconds;
    try
    {
      while (await timer.WaitForNextTickAsync(cancellation.Token))
      {
        var now = clock.Elapsed.TotalSeconds;
        var delta = Math.Min(0.05, now - previous);
        previous = now;
        var direction = (held.Contains("ArrowRight") || held.Contains("KeyD") ? 1 : 0) -
          (held.Contains("ArrowLeft") || held.Contains("KeyA") ? 1 : 0);
        if (game.AcceptsInput && direction != 0)
        {
          if (direction != held_direction)
          {
            game.Move(direction, 0);
            repeat_time = 0;
            repeating = false;
          }
          else
          {
            repeat_time += delta;
            if (repeat_time >= (repeating ? 0.075 : 0.18))
            {
              game.Move(direction, 0);
              repeat_time = 0;
              repeating = true;
            }
          }
        }
        held_direction = game.AcceptsInput ? direction : 0;
        game.Advance(delta, held.Contains("ArrowDown") || held.Contains("KeyS"));
        if (!game.Paused && (notice_time -= delta) <= 0) notice_key = "";
        if (game.Phase == GamePhase.Won && selection.PuzzleNumber is int completed && completed_levels.Add(completed))
        {
          if (interop is not null) await interop.InvokeVoidAsync("saveCompletedIds", completed_levels.ToArray());
        }
        foreach (var metric in game.Metrics.Where(metric => metric.Definition.RecordPolicy == RecordPolicy.Max))
        {
          var key = ModeCatalog.RecordKey(game.Mode, metric.Key);
          if (metric.Value <= records.GetValueOrDefault(key)) continue;
          records[key] = metric.Value;
          if (interop is not null) await interop.InvokeVoidAsync("saveRecord", key, metric.Value);
        }
        await InvokeAsync(StateHasChanged);
      }
    }
    catch (OperationCanceledException) { }
  }

  private void Start(bool demo = false)
  {
    if (demo) selection = GameSelection.Free;
    game = demo ? GameSession.CreateDemo() : GameSessionFactory.Create(selection, Random.Shared.Next());
    held.Clear();
    held_direction = 0;
    notice_key = demo ? "demo_hint" : game.Presentation.IntroKey;
    notice_arguments = [];
    notice_time = 3;
    game.Matched += wave =>
    {
      notice_key = "match";
      notice_arguments = [wave.Pieces.Count, UiText.Number(wave.Points), wave.Chain];
      notice_time = 1.8;
      PlayTone(360 + wave.Chain * 140, 0.25);
    };
    game.PieceLocked += () => PlayTone(160, 0.08);
  }

  [JSInvokable]
  public void KeyChanged(string key, bool pressed)
  {
    if (!pressed) { held.Remove(key); return; }
    held.Add(key);
    switch (key)
    {
      case "ArrowUp": case "KeyW": game.Rotate(); break;
      case "Space": game.HardDrop(); break;
      case "KeyP": case "Escape": TogglePause(); break;
      case "KeyR": Start(); break;
      case "F2": ShowHintOrDemo(); break;
      case "KeyM": ToggleSound(); break;
      case "Enter": Confirm(); break;
    }
  }

  [JSInvokable]
  public void PauseForFocus() { game.SetPaused(true); held.Clear(); }
  private void TogglePause() { game.SetPaused(!game.Paused); held.Clear(); }
  private void Confirm()
  {
    if (game.IsFinished && game.ContinueAction == ContinueAction.NextPuzzle)
    {
      if (selection.PuzzleNumber is not int levelNumber) return;
      completed_levels.Add(levelNumber);
      if (interop is not null) _ = interop.InvokeVoidAsync("saveCompletedIds", completed_levels.ToArray());
      selection = GameSelection.Puzzle(PuzzleLevels.NextLevel(levelNumber));
      Start();
    }
    else if (game.IsFinished) Start();
    else if (game.Paused) TogglePause();
  }
  private bool IsCompleted(int number) => completed_levels.Contains(number);
  private void SelectMode(ChangeEventArgs args)
  {
    if (!GameSelection.TryParse(args.Value?.ToString(), out var selected)) return;
    selection = selected;
    Start();
  }
  private void ShowHintOrDemo()
  {
    switch (game.Presentation.Help.Action)
    {
      case HelpAction.Demo:
        Start(true);
        return;
      case HelpAction.Rules:
        notice_key = game.Presentation.Help.ContentKey;
        notice_time = 4;
        break;
      case HelpAction.PuzzleHint:
        notice_key = game.Puzzle!.HintKey;
        notice_time = 12;
        break;
    }
    game.SetPaused(false);
    held.Clear();
    notice_arguments = [];
  }
  private int Record(string metric) => records.GetValueOrDefault(ModeCatalog.RecordKey(game.Mode, metric));
  private string PieceLabel(Piece piece) => piece.Kind switch
  {
    PieceKind.SpecialUnknown => T("piece_special"),
    PieceKind.Black => game.TurnsRemaining(piece) is { } remaining
      ? T("piece_black", remaining)
      : T("piece_black_active"),
    PieceKind.White => T("piece_white"),
    _ => T("preview", piece.Shape, piece.Color + 1)
  };
  private string ResultSummary()
  {
    var counter = game.Metrics.FirstOrDefault(metric => metric.Definition.Display == MetricDisplay.Counter);
    return T(game.Presentation.ResultSummaryKey, UiText.Number(game.Score), counter?.Value ?? 0);
  }
  private void ToggleSound() { sound_enabled = !sound_enabled; PlayTone(500, 0.1); }
  private void PlayTone(int frequency, double duration)
  {
    if (sound_enabled && interop is not null) _ = interop.InvokeVoidAsync("tone", frequency, duration);
  }
  public async ValueTask DisposeAsync()
  {
    cancellation.Cancel();
    if (loop is not null) await loop;
    if (interop is not null)
    {
      await interop.InvokeVoidAsync("disconnect");
      await interop.DisposeAsync();
    }
    callback?.Dispose();
    cancellation.Dispose();
  }
}
